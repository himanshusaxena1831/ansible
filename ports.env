TARGET1_PORTS=8001:80,8441:443
TARGET2_PORTS=8002:80
TARGET3_PORTS=8003:80
TARGET4_PORTS=8004:80
TARGET5_PORTS=8005:80
TARGET6_PORTS=8006:80
TARGET7_PORTS=8007:80
TARGET8_PORTS=8008:80
TARGET9_PORTS=8009:80
TARGET10_PORTS=8010:80

# Debian Targets Port Mappings
DEBIAN1_PORTS=9001:80,9441:443
DEBIAN2_PORTS=9002:80
DEBIAN3_PORTS=9003:80
